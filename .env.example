APP_NAME="Mi CV"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Base de datos (MySQL / MariaDB en el VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mi_cv
DB_USERNAME=mi_cv
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# ── PDF con Chromium (Browsershot + Puppeteer)
# Vacío = usa el Chrome que descarga Puppeteer con "npm install".
# Si instalaste Chromium del sistema, pon su ruta, ej: /usr/bin/chromium-browser o /usr/bin/google-chrome
MICV_CHROME_PATH=
# Rutas de node/npm. Vacío = automático (Windows usa el PATH; Linux busca /usr/bin y /usr/local/bin).
MICV_NODE_BINARY=
MICV_NPM_BINARY=
MICV_CHROME_NO_SANDBOX=true
MICV_PDF_TIMEOUT=60

# Producción: con HTTPS ponga SESSION_SECURE_COOKIE=true. Detrás de Cloudflare/proxy: TRUSTED_PROXIES=*
#SESSION_SECURE_COOKIE=true
#TRUSTED_PROXIES=*

# Perfil opcional de fondo: actual (conserva su modelo), u2net, isnet, birefnet
MICV_FONDO_PERFIL=actual
# BiRefNet requiere instalar onnxruntime-node y descargar el modelo por consola.

# API de escritorio: siempre HTTPS en producción.
DESKTOP_REQUIRE_HTTPS=true
# DESKTOP_SIGNING_KEY_PATH=/ruta/privada/desktop-signing.key

# Servidor de la aplicación de escritorio
DESKTOP_SERVER_URL=https://micv.sistemajz.com
